# Copy this file to .env and fill in your values
# cp .env.example .env

# Required: Anthropic API key for LLM calls
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override SurrealDB endpoint (default: ws://127.0.0.1:8000/rpc)
# SURREAL_URL=ws://127.0.0.1:8000/rpc

# Optional: choose a primary Claude model. Can be a single value.
# GODEYE_LLM_MODEL=claude-3-5-sonnet-20240620

# Optional: fallback model chain (comma-separated, first valid model is used).
# GODEYE_LLM_MODELS=claude-3-5-sonnet-latest,claude-3-5-sonnet-20240620,claude-3-haiku-20240307

# Optional: SurrealDB credentials (defaults to root/root for local dev)
# SURREAL_USER=root
# SURREAL_PASSWORD=root

# Optional: CORS allow-list. Use comma-separated origins in prod (no wildcard).
# CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# Optional: API keys to secure endpoints. Comma-separated list, e.g. key1,key2.
# Leave unset for local no-auth mode.
# GODEYE_API_KEYS=

# Optional: Maximum checkpoints kept per thread for automatic retention.
# Unset = unlimited history.
# Set to 0 to keep no checkpoints.
# GODEYE_CHECKPOINT_LIMIT=

# Optional: Checkpointer behavior when SurrealDB checkpoint queries time out.
# - true: keep strict checkpointing and raise errors (can fail replay endpoint on DB issues).
# - false (default): continue replay without persisted checkpoints when persistence is temporarily unavailable.
# GODEYE_CHECKPOINT_STRICT=false

# Optional: SurrealDB checkpoint query timeout in seconds.
# Longer values can reduce false failures on slow/local DBs.
# GODEYE_CHECKPOINT_TIMEOUT_SECONDS=20

# Optional: LangSmith tracing (https://smith.langchain.com)
# Sign up free, create a project named "GodEye", and paste your API key below.
# When set, every LangGraph run is traced automatically — no code changes needed.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=GodEye
