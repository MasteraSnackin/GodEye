# Copy this file to .env and fill in your values
# cp .env.example .env

# Required: Anthropic API key for LLM calls
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override SurrealDB endpoint (default: ws://127.0.0.1:8000/rpc)
# SURREAL_URL=ws://127.0.0.1:8000/rpc

# Optional: LangSmith tracing (https://smith.langchain.com)
# Sign up free, create a project named "GodEye", and paste your API key below.
# When set, every LangGraph run is traced automatically — no code changes needed.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=GodEye
